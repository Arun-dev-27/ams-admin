# Demo BU app that signs in through oidc_mfa_auth (Core).
APP_KEY=ams-admin
APP_LABEL=AMS Admin
CLIENT_ID=ams-admin-dev
# ADMIN | MUMIN - must match the client's realm in Core
APP_REALM=ADMIN
PORT=5174
HOST=127.0.0.1
# Public origin of this app. The redirect / logout / back-channel / handoff URIs registered in Core
# are <BASE_URL>/auth/callback, /logged-out, /auth/core/logout, /auth/core/handoff
BASE_URL=http://localhost:5174
ISSUER=http://localhost:4000

# Client secret: CLIENT_SECRET, or the file printed by `npm run client:register` in oidc_mfa_auth
CLIENT_SECRET=
CLIENT_SECRET_FILE=../../oidc_mfa_auth/.e2e-ams-admin.txt

# Apps this one can hand off to: <client_id>:<label>:<realm>, comma separated
PEER_APPS=rms-admin-dev:RMS Admin:ADMIN,rms-mumin-dev:RMS Mumin:MUMIN
# Paths this app accepts from an incoming handoff ("*" = one segment)
HANDOFF_PATHS=/dashboard,/events/*,/events/*/details,/bookings/*,/admin/*
